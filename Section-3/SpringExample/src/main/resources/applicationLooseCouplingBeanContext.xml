<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->

    <bean id="myUserDatabaseProvider" class="com.loose.coupling.UserDatabaseProvider">
    </bean>

    <bean id="webServiceProvider" class="com.loose.coupling.WebServiceProvider">
    </bean>

    <bean id="newUserDatabaseProvider" class="com.loose.coupling.NewUserDatabaseProvider">
    </bean>

    <bean id="myUserManager" class="com.loose.coupling.UserManager">
        <constructor-arg ref="myUserDatabaseProvider"/>
    </bean>

    <bean id="myUserManagerWS" class="com.loose.coupling.UserManager">
        <constructor-arg ref="webServiceProvider"/>
    </bean>

    <bean id="myUserManagerNew" class="com.loose.coupling.UserManager">
        <constructor-arg ref="newUserDatabaseProvider"/>
    </bean>

</beans>